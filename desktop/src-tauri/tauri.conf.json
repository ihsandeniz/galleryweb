{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GalleryWeb",
  "version": "1.1.1",
  "identifier": "net.tr.ihsandeniz.galleryweb",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "category": "Photography",
    "shortDescription": "Yerel fotoğraf galerisi",
    "longDescription": "GalleryWeb — bilgisayarındaki fotoğraf ve videoları tarayan, etiketleyen ve düzenleyen yerel galeri uygulaması. İnternet bağlantısı gerektirmez, hiçbir veri dışarı gönderilmez."
  }
}
